@article{sirirungruang_substrate-multiplexed_2025,
	title = {A substrate-multiplexed platform for profiling enzymatic potential of plant family 1 glycosyltransferases},
	volume = {16},
	issn = {2041-1723},
	url = {https://doi.org/10.1038/s41467-025-61530-6},
	doi = {10.1038/s41467-025-61530-6},
	abstract = {Plants have expanded various biosynthetic enzyme families to produce a wide diversity of natural products; however, most enzymes encoded in plant genomes remain uncharacterized, highlighting the need for new functional genomic approaches. Here, we report a platform enabling the rapid functional characterization of plant family 1 glycosyltransferases, which serve important roles in plant development, defense, and communication. Using substrate-multiplexed reactions, mass spectrometry, and automated analysis, we screen 85 enzymes against a diverse library of 453 natural products, for a total of nearly 40,000 possible reactions. The resulting dataset reveals a widespread promiscuity and a strong preference for planar, hydroxylated aromatic substrates among family 1 glycosyltransferases. We also characterize glycosyltransferases with an unusually wide substrate scope and with a non-canonical Cys-Asp catalytic dyad. This work establishes a widely-applicable enzymatic screening pipeline, reflects the immense glycosylation capability of plants, and has implications in biocatalysis, metabolic engineering, and gene discovery.},
	number = {1},
	journal = {Nature Communications},
	author = {Sirirungruang, Sasilada and Blay, Vincent and Rodriguez, Elys P. and Scott, Yasmine F. and Vuu, Khanh M. and Barnum, Collin R. and Opgenorth, Paul H. and Kong, Fanzhou and Li, Yuanyue and Fiehn, Oliver and Shih, Patrick M.},
	month = jul,
	year = {2025},
	pages = {6366},
}

